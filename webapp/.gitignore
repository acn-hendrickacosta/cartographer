# frontend/node_modules is excluded; frontend's *build output*
# (backend/app/static/dist/) is intentionally NOT excluded -- it's committed
# so the backend can run without Node/npm, same pattern as cli/ui-src ->
# cli/src/cartographer/ui/static. Only edit frontend/src/ by hand; dist/ is
# regenerated by `npm run build` and should be rebuilt+recommitted alongside
# any frontend source change.
